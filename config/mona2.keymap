#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER 0
#define JIS_LAYER 1
#define ARROW_LAYER 2
#define SYMBOL_LAYER 3
#define MOUSE_LAYER 4
#define SCROLL_LAYER 5
#define BLUETOOTH_LAYER 6
#define SYMBOL_JIS_LAYER 7
#define ARROW_JIS_LAYER 8
#define AML_TIMEOUT_MS 10000
#define AML_IDLE_GUARD_MS 200

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    input_processors {
        aml_temp_layer: aml_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
            require-prior-idle-ms = <AML_IDLE_GUARD_MS>;
            excluded-positions = <
                7
                17
                19
                20
                26
                29
                30
                32
                33
            >;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to DEFAULT_LAYER &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        bt_sel_0_us: bt_sel_0_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "BT_SEL_0_JIS";
        };

        bt_sel_1_us: bt_sel_1_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 0>;
            label = "BT_SEL_1_JIS";
        };

        bt_sel_2_jis: bt_sel_2_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to JIS_LAYER>;
            label = "BT_SEL_2_JIS";
        };

        bt_sel_3_jis: bt_sel_3_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to JIS_LAYER>;
            label = "BT_SEL_3_JIS";
        };

        bt_sel_4_jis: bt_sel_4_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &to JIS_LAYER>;
            label = "BT_SEL_4_JIS";
        };
    };

    behaviors {
        tog_on: toggle_layer_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        lang_change_tap_dance: lang_change_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "LANG_CHANGE_TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&mt LEFT_GUI LANG1>, <&kp LANG2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W         &kp E             &kp R               &kp T                                                           &kp Y         &kp U  &kp I               &kp O    &kp P
&kp A           &kp S         &kp D             &kp F               &kp G                                            &kp SEMICOLON  &kp H         &kp J  &lt SCROLL_LAYER K  &kp L    &kp MINUS
&kp Z           &kp X         &kp C             &kp V               &kp B                  &mkp MB1                  &kp EQUAL      &kp N         &kp M  &kp COMMA           &kp DOT  &kp SLASH
&kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_CONTROL  &mt LEFT_GUI LANG2  &lt ARROW_LAYER SPACE  &lt SYMBOL_LAYER LANG1    &kp BACKSPACE  &lt 6 RETURN                                      &kp RG(RSHFT)
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        default_layer_jis {
            bindings = <
&kp Q           &kp W         &kp E             &kp R               &kp T                                                                   &kp Y         &kp U  &kp I               &kp O    &kp P
&kp A           &kp S         &kp D             &kp F               &kp G                                                    &kp SEMICOLON  &kp H         &kp J  &lt SCROLL_LAYER K  &kp L    &kp MINUS
&kp Z           &kp X         &kp C             &kp V               &kp B                      &mkp MB1                      &kp EQUAL      &kp N         &kp M  &kp COMMA           &kp DOT  &kp SLASH
&kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_CONTROL  &mt LEFT_GUI LANG2  &lt ARROW_JIS_LAYER SPACE  &lt SYMBOL_JIS_LAYER LANG1    &kp BACKSPACE  &lt 6 RETURN                                      &kp RG(RSHFT)
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        ARROW {
            bindings = <
&kp ESCAPE        &trans        &kp LS(UP_ARROW)  &trans         &kp LEFT_PARENTHESIS                             &kp RIGHT_PARENTHESIS  &kp LC(A)           &kp UP_ARROW      &kp LC(E)            &kp END
&kp TAB           &kp LS(LEFT)  &kp LS(DOWN)      &kp LS(RIGHT)  &kp LEFT_BRACE                    &mkp MB4       &kp RIGHT_BRACE        &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW      &kp HOME
&trans            &trans        &trans            &trans         &kp LEFT_BRACKET      &mkp MB2    &mkp MB5       &kp RIGHT_BRACKET      &kp LC(LEFT_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &trans
&kp LS(LEFT_GUI)  &trans        &trans            &trans         &trans                &trans      &kp LG(MINUS)  &kp LG(PLUS)                                                                      &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        symbols {
            bindings = <
&kp N1            &kp N2       &kp N3    &kp N4      &kp N5                         &kp N6     &kp N7         &kp N8             &kp N9            &kp N0
&kp EXCLAMATION   &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT            &trans  &kp CARET  &kp AMPERSAND  &kp ASTERISK       &kp UNDERSCORE    &kp PLUS
&kp TILDE         &kp GRAVE    &trans    &trans      &trans       &trans    &trans  &kp COLON  &kp SEMICOLON  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp PIPE
&kp LS(LEFT_GUI)  &trans       &trans    &trans      &trans       &trans    &trans  &trans                                                         &kp BACKSLASH
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &mkp MB3  &trans    &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp MB1  &trans    &mkp MB2  &tog_off MOUSE_LAYER
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans    &trans    &tog_on MOUSE_LAYER
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        bluetooth_fn {
            bindings = <
&to DEFAULT_LAYER  &to JIS_LAYER  &trans  &trans  &trans                       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4
&kp F1             &kp F2         &kp F3  &kp F4  &kp F5              &trans   &bt_sel_0_us  &bt_sel_1_us  &bt_sel_2_jis  &bt_sel_3_jis  &bt_sel_4_jis
&kp F6             &kp F7         &kp F8  &kp F9  &kp F10  &kp F11    &kp F12  &trans        &trans        &trans         &trans         &bt BT_CLR
&bootloader        &trans         &trans  &trans  &trans   &trans     &trans   &trans                                                    &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        symbols_jis {
            bindings = <
&kp N1            &kp N2            &kp N3    &kp N4      &kp N5                         &kp N6            &kp N7         &kp N8             &kp N9         &kp N0
&kp EXCLAMATION   &kp LEFT_BRACKET  &kp HASH  &kp DOLLAR  &kp PERCENT            &trans  &kp EQUAL         &kp CARET      &kp DOUBLE_QUOTES  &kp LS(INT1)   &kp COLON
&kp PLUS          &kp GRAVE         &trans    &trans      &trans       &trans    &trans  &kp SINGLE_QUOTE  &kp SEMICOLON  &kp AT_SIGN        &kp AMPERSAND  &kp LS(INT3)
&kp LS(LEFT_GUI)  &trans            &trans    &trans      &trans       &trans    &trans  &trans                                                             &kp INT3
            >;
        };

        ARROW_JIS {
            bindings = <
&kp ESCAPE          &trans        &kp LS(UP_ARROW)  &trans         &kp LS(N8)                                        &kp LS(N9)           &kp LC(A)           &kp UP_ARROW      &kp LC(E)            &kp END
&kp TAB             &kp LS(LEFT)  &kp LS(DOWN)      &kp LS(RIGHT)  &kp LS(RIGHT_BRACKET)              &mkp MB4       &kp LS(NON_US_HASH)  &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW      &kp HOME
&kp LC(LA(DELETE))  &trans        &trans            &trans         &kp RIGHT_BRACKET      &mkp MB2    &mkp MB5       &kp NON_US_HASH      &kp LC(LEFT_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &trans
&kp LS(LEFT_GUI)    &trans        &trans            &trans         &trans                 &trans      &kp LG(MINUS)  &kp LG(PLUS)                                                                    &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };
    };
};

&trackball_central_listener {
    input-processors =
        <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
        <&aml_temp_layer MOUSE_LAYER AML_TIMEOUT_MS>;
};

&mkp_input_listener { input-processors = <&aml_temp_layer MOUSE_LAYER AML_TIMEOUT_MS>; };
